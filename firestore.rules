rules_version = '2';

// The browser never talks to Firestore. All reads and writes go through the
// `api` Cloud Function, which uses the Admin SDK and is not bound by these
// rules. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
